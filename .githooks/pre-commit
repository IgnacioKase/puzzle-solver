#!/usr/bin/env bash
# Formats and lints staged Python files with ruff before the commit is written.
# Needs bash 4.4+ for `mapfile -d` (macOS's stock /bin/bash 3.2 is too old).
#
# Enable in a fresh clone with:   git config core.hooksPath .githooks
# Bypass for one commit with:     git commit --no-verify
# or:                             SKIP_RUFF=1 git commit

set -euo pipefail

if [ -n "${SKIP_RUFF:-}" ]; then
    echo "pre-commit: SKIP_RUFF set, skipping ruff."
    exit 0
fi

RUFF_VERSION=0.16.8

# Staged Python files, including renames; NUL delimiters preserve spaces.
staged=()
mapfile -t -d '' staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py')
if [ ${#staged[@]} -eq 0 ]; then
    exit 0
fi

# Pinned through uv so every clone formats identically; a ruff already on PATH
# is the fallback when uv is not installed.
if command -v uv >/dev/null 2>&1; then
    ruff() { uv tool run --quiet "ruff@${RUFF_VERSION}" "$@"; }
elif command -v ruff >/dev/null 2>&1; then
    if [ "$(command ruff --version)" != "ruff ${RUFF_VERSION}" ]; then
        echo "pre-commit: install ruff==${RUFF_VERSION} or use uv to match CI."
        exit 1
    fi
    ruff() { command ruff "$@"; }
else
    echo "pre-commit: neither uv nor ruff is installed."
    echo "  Install uv (https://docs.astral.sh/uv/) or run: pip install ruff==${RUFF_VERSION}"
    echo "  To commit without formatting: git commit --no-verify"
    exit 1
fi

# A file staged in one state while the working tree holds another cannot be
# formatted safely: rewriting the working copy would sweep the unstaged edits
# into this commit. Stop and let the author decide.
mapfile -t -d '' unstaged < <(git diff --name-only -z -- "${staged[@]}")
if [ ${#unstaged[@]} -gt 0 ]; then
    echo "pre-commit: these files are staged but also have unstaged changes:"
    printf '  %s\n' "${unstaged[@]}"
    echo "Formatting them would pull the unstaged edits into the commit."
    echo "Stage them (git add) or set them aside (git stash -k), then commit again."
    exit 1
fi

# Content hashes before the rewrite, so the author is told what ruff touched.
declare -A before
for f in "${staged[@]}"; do
    before["$f"]=$(git hash-object -- "$f")
done

# Lint fixes first, formatter last: a fix can leave the file unformatted
# (a removed import leaves a stray blank line), so the formatter gets the
# final word.
# Output suppressed: whatever it cannot fix is reported by the gate check below.
ruff check --quiet --fix -- "${staged[@]}" >/dev/null 2>&1 || true
ruff format --quiet -- "${staged[@]}"

reformatted=()
for f in "${staged[@]}"; do
    if [ "${before["$f"]}" != "$(git hash-object -- "$f")" ]; then
        reformatted+=("$f")
    fi
done

git add -- "${staged[@]}"

if [ ${#reformatted[@]} -gt 0 ]; then
    echo "pre-commit: ruff reformatted these files and restaged them:"
    printf '  %s\n' "${reformatted[@]}"
fi

# --quiet keeps this silent on success and still prints the diagnostics on failure.
if ! ruff check --quiet -- "${staged[@]}"; then
    echo
    echo "pre-commit: the findings above need a human fix; the commit was stopped."
    echo "  Bypass with: git commit --no-verify"
    exit 1
fi

exit 0
